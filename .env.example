# Copy to .env and fill in local values. Never commit .env.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=helpdesk
POSTGRES_USER=
POSTGRES_PASSWORD=
# Host port for the docker-compose database. Use another one (e.g. 5433) if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=helpdesk;Username=;Password=

# Frontend
VITE_API_BASE_URL=http://localhost:5038
