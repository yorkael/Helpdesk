# Copy to .env and fill in local values. Never commit .env.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=helpdesk
POSTGRES_USER=
POSTGRES_PASSWORD=
# Host port for the docker-compose database. Use another one (e.g. 5433) if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=helpdesk;Username=;Password=

# JWT signing key: at least 32 random bytes encoded as base64. The API refuses to start without it.
# For local development prefer user secrets (see README); this variable is for containers and hosting.
# Generate one with either of these:
#   PowerShell 5.1 or 7: $bytes = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
#   Bash (openssl):      openssl rand -base64 48
Jwt__SigningKey=

# Frontend
VITE_API_BASE_URL=http://localhost:5038
