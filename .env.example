# Copy to .env and fill in local values. Never commit .env.
# docker compose reads this file; the API run with `dotnet run` does not (it uses user secrets).

# PostgreSQL (required by every docker compose command)
POSTGRES_DB=helpdesk
POSTGRES_USER=
POSTGRES_PASSWORD=
# Host port for the database. Use another one (e.g. 5433) if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432

# JWT signing key: at least 32 random bytes encoded as base64.
# Required for the full stack (`docker compose up`): without it the migrate service fails and the API
# does not start. Not needed for the database alone (`docker compose up -d db`).
# Generate one with either of these:
#   PowerShell 5.1 or 7: $bytes = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
#   Bash (openssl):      openssl rand -base64 48
Jwt__SigningKey=

# Host ports for the full stack, bound to 127.0.0.1.
# API_PORT serves the API directly; WEB_PORT serves the frontend, which proxies /api/ to the API.
API_PORT=8080
WEB_PORT=8081
